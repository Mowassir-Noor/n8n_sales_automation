    {
      "id": "272f5d8c-1f28-4c4c-a4a9-42a262adcce3",
      "name": "Research with Claude",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        960,
        112
      ],
      "parameters": {
        "messages": {
          "values": [
            {
              "content": "=Today is {{ $now.toFormat('yyyy-MM-dd') }}. Treat anything dated before today as past, not upcoming.\n\nCompany: {{ $json.Company }}\nWebsite: {{ $json.Website }}\nCountry: {{ $json.Country }}\n\nResearch this company with web search and return only the JSON object.",
              "role": "user"
            }
          ]
        },
        "modelId": {
          "__rl": true,
          "cachedResultName": "Claude Sonnet 5.5",
          "mode": "list",
          "value": "claude-sonnet-5-5"
        },
        "operation": "message",
        "options": {
          "includeMergedResponse": true,
          "maxTokens": 4096,
          "maxToolsIterations": 12,
          "maxUses": 8,
          "system": "You are a B2B sales researcher for Texprove, a Digital Product Passport SaaS for textile and apparel exporters to the EU. For the given textile company, use web search to find: what they make, which EU markets or brands they export to, company size, sustainability or certification signals (OEKO-TEX, GOTS, GRS, BCI), recent news from the last year (new factory, new certification, EU brand deal, trade fair), and the best decision maker (export manager, sustainability manager, CEO) with their title, work email and LinkedIn URL if published.\n\nSearch plan (at most 8 searches): the company website and its about, sustainability, certificate and contact pages; the company name with words like ihracat, export, Europe, GOTS, OEKO-TEX; the company name with news words (haber, yeni fabrika, sertifika, fuar); the company name with export manager, ihracat müdürü, genel müdür, LinkedIn. Never invent facts, names or emails; leave a field empty if you cannot verify it on a page you found. Never record order volumes, prices or buyer contract details.\n\nRespond with ONLY a JSON object, no markdown fences, no commentary, with exactly these keys: research_notes (max 80 words), personalisation_hook (one specific, verifiable fact to open an email with, preferring recent news), contact_name, contact_title, email, linkedin, segment (one of Knitwear, Woven apparel, Denim, Home textile, Fabric mill, Yarn, Sportswear, Technical textile, Other), language (tr or en: tr when the company site is mainly Turkish).",
          "webSearch": true
        },
        "resource": "text",
        "simplify": true
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "anthropicApi": {
          "id": "JXZ5NOJvJ6mIjWyY",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "fee3b7e2-dc38-4778-a45c-073e1aba9e91",
      "name": "Parse Research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        112
      ],
      "parameters": {
        "jsCode": "// Pulls the JSON object out of Claude's reply (the reply can contain search blocks and text). Output shape: { output: {...} } like the old agent, or { error } when nothing parsable came back.\nconst keys = ['research_notes', 'personalisation_hook', 'contact_name', 'contact_title', 'email', 'linkedin', 'segment', 'language'];\nfunction strings(v, acc) {\n  if (typeof v === 'string') acc.push(v);\n  else if (Array.isArray(v)) v.forEach(x => strings(x, acc));\n  else if (v && typeof v === 'object') Object.values(v).forEach(x => strings(x, acc));\n  return acc;\n}\nfunction extract(text) {\n  const s = text.indexOf('{'); const e = text.lastIndexOf('}');\n  if (s < 0 || e <= s) return null;\n  for (let end = e; end > s; end = text.lastIndexOf('}', end - 1)) {\n    try { const o = JSON.parse(text.slice(s, end + 1)); if (o && typeof o === 'object') return o; } catch (err) { /* try a shorter slice */ }\n  }\n  return null;\n}\nreturn $input.all().map(item => {\n  const body = item.json || {};\n  if (body.error && !body.content && !body.merged) return { json: { error: String(body.error.message || body.error).slice(0, 500) } };\n  const texts = strings(body, []).filter(t => t.includes('personalisation_hook'));\n  let parsed = null;\n  for (const t of texts) { parsed = extract(t); if (parsed) break; }\n  if (!parsed) return { json: { error: 'No JSON in reply: ' + strings(body, []).join(' ').slice(0, 400) } };\n  const out = {};\n  for (const k of keys) out[k] = String(parsed[k] ?? '').trim();\n  if (!['tr', 'en'].includes(out.language)) out.language = 'en';\n  return { json: { output: out } };\n});"
      }
    },
