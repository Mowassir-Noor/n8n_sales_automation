    {
      "parameters": {
        "jsCode": "// Estimates HubSpot actions used this month from the Leads tab.\n// Counting rule (HubSpot free plan, 3,000 actions/month): first email = 2 (contact upsert + logged email),\n// each follow-up = 1 (logged email), each reply = 2 (logged email + lead status).\n// Follow-up dates are estimated as Sent At + 4 / +10 / +20 days.\nconst rows = $('Get All Leads').all().map(i => i.json).filter(r => r && r['Lead ID']);\nconst settings = ($('Read Settings').first() || {}).json || {};\nconst limit = Number(settings['HubSpot Monthly Limit']) || 3000;\nconst pauseAt = Number(settings['HubSpot Pause Percent']) || 80;\n\nconst now = new Date();\nconst y = now.getUTCFullYear();\nconst m = now.getUTCMonth();\nconst inMonth = (d) => { const t = new Date(d); return !isNaN(t) && t.getUTCFullYear() === y && t.getUTCMonth() === m; };\nconst addDays = (d, n) => { const t = new Date(d); t.setUTCDate(t.getUTCDate() + n); return t; };\nconst offsets = [4, 10, 20];\n\nlet used = 0;\nconst detail = { firstEmails: 0, followUps: 0, replies: 0 };\nfor (const r of rows) {\n  const sentAt = r['Sent At'];\n  const sentValid = sentAt && !isNaN(new Date(sentAt));\n  if (sentValid && inMonth(sentAt)) { used += 2; detail.firstEmails++; }\n  const fu = Math.min(Number(r['Follow-up Count'] || 0), 3);\n  if (sentValid) {\n    for (let k = 0; k < fu; k++) {\n      if (inMonth(addDays(sentAt, offsets[k]))) { used += 1; detail.followUps++; }\n    }\n  }\n  if (String(r['Reply Category'] || '') !== '' && inMonth(r['Last Updated'])) { used += 2; detail.replies++; }\n}\n\nconst percent = Math.round((used / limit) * 100);\nreturn [{ json: {\n  hubspot_actions_used: used,\n  hubspot_limit: limit,\n  percent,\n  pause_at: pauseAt,\n  paused: percent >= pauseAt,\n  detail,\n  nil_email: settings['Nil Email'] || '',\n  sheet_url: settings['Sheet URL'] || '',\n} }];"
      },
