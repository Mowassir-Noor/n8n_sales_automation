        416
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Email reply from a sales lead (may be Turkish or English).\nSubject: {{ $('Find Lead by Thread').item.json._reply.subject }}\n\n{{ $('Find Lead by Thread').item.json._reply.text }}\n\nReturn: (1) a one-sentence summary IN ENGLISH; (2) whether the sender asked to be removed / not contacted again (yes or no); (3) exactly one category: Hot = wants a call, demo or pricing; Warm = interested, asks a question, or says later; Cold = vague or not now, but no refusal; Not interested = refuses or asks not to be contacted; Auto-reply = out of office, bounce or other automatic message.",
        "hasOutputParser": true,
        "needsFallback": true,
        "batching": {}
      }
    },
