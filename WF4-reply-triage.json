              "id": "st",
              "name": "stage",
              "type": "string",
              "value": "={{ ($('Summarize Reply').item.json.output.removal_requested === 'yes' || $json.category === 'Not interested') ? 'Opted out' : 'Replied - ' + $json.category }}"
            },
            {
              "id": "oo",
              "name": "opt_out",
              "type": "string",
              "value": "={{ ($('Summarize Reply').item.json.output.removal_requested === 'yes' || $json.category === 'Not interested') ? 'Yes' : ($('Find Lead by Thread').item.json['Opt-out'] || '') }}"
            },
            {
              "id": "hs",
              "name": "hs_status",
              "type": "string",
              "value": "={{ ($('Summarize Reply').item.json.output.removal_requested === 'yes' || $json.category === 'Not interested') ? 'UNQUALIFIED' : ($json.category === 'Hot' ? 'IN_PROGRESS' : 'OPEN') }}"
            },
