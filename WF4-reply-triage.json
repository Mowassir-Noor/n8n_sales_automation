              "id": "hs",
              "name": "hs_status",
              "type": "string",
              "value": "={{ ($('Summarize Reply').item.json.output.removal_requested === 'yes' || $json.category === 'Not interested') ? 'UNQUALIFIED' : ($json.category === 'Hot' ? 'IN_PROGRESS' : 'OPEN') }}"
