    {
      "id": "e4528ea8-c0e0-47aa-9435-251acb88a6a9",
      "name": "Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        416
      ],
      "parameters": {
        "jsCode": "// Normalises an incoming reply from either the Gmail Trigger or the IMAP Trigger.\nconst addr = (v) => {\n  if (!v) return '';\n  if (typeof v === 'string') { const m = v.match(/<([^>]+)>/); return (m ? m[1] : v).trim(); }\n  return (v.value && v.value[0] && v.value[0].address) || '';\n};\nreturn $input.all().map((it, i) => {\n  const j = it.json;\n  const isGmail = !!j.threadId;\n  return {\n    json: {\n      source: isGmail ? 'gmail' : 'imap',\n      message_id: isGmail ? j.id : String(j.messageId || ''),\n      thread_id: isGmail ? j.threadId : '',\n      in_reply_to: isGmail ? '' : String(j.inReplyTo || ''),\n      references: isGmail ? '' : (Array.isArray(j.references) ? j.references.join(' ') : String(j.references || '')),\n      subject: String(j.subject || ''),\n      text: String(j.text || j.textPlain || ''),\n      from: addr(j.from).toLowerCase(),\n      to: addr(j.to),\n    },\n    pairedItem: { item: i },\n  };\n});"
      }
    },
    {
      "id": "81bd7e43-abb9-469f-b63a-599832c76c4d",
      "name": "Find Lead by Thread",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        416
      ],
      "parameters": {
        "jsCode": "// Matches each reply to its lead. No match = the reply is ignored.\n// Gmail: by Gmail Thread ID. IMAP/SMTP: by In-Reply-To/References against the stored 'smtp:<Message-ID>',\n// then by sender = lead email, then by subject (without Re:/Ynt:) among leads still in Sent / Follow-up stages.\nconst replies = $('Reply').all().map(i => i.json);\nconst leads = $('Get Leads (reply)').all().map(i => i.json).filter(r => r && r['Lead ID']);\nconst norm = (s) => String(s || '').replace(/[<>]/g, '').trim().toLowerCase();\nconst baseSubj = (s) => String(s || '').replace(/^\\s*((re|ynt|aw|fw|fwd|ynt\\.)\\s*:\\s*)+/i, '').trim().toLowerCase();\nconst open = ['Sent', 'Follow-up 1', 'Follow-up 2', 'Follow-up 3'];\nconst out = [];\nfor (const r of replies) {\n  let lead;\n  if (r.source === 'gmail') {\n    lead = leads.find(l => String(l['Gmail Thread ID'] || '') === r.thread_id);\n  } else {\n    const ids = (r.in_reply_to + ' ' + r.references).split(/\\s+/).map(norm).filter(Boolean);\n    lead = leads.find(l => { const t = String(l['Gmail Thread ID'] || ''); return t.startsWith('smtp:') && ids.includes(norm(t.slice(5))); });\n    if (!lead) lead = leads.find(l => open.includes(l.Stage) && r.from && norm(l.Email) === r.from);\n    if (!lead) { const s = baseSubj(r.subject); if (s) lead = leads.find(l => open.includes(l.Stage) && baseSubj(l.Subject) === s); }\n  }\n  if (lead) out.push({ json: { ...lead, _reply: r } });\n}\nreturn out;"
      }
    },
