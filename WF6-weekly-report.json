    {
      "id": "315ea5c4-c32a-4385-b6b6-cb571e778c02",
      "name": "Compute Weekly Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        112
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => Object.keys(r).length > 0);\nconst cutoff = Date.now() - 7 * 24 * 3600 * 1000;\nconst within = (v) => { const t = Date.parse(String(v || '')); return !isNaN(t) && t >= cutoff; };\nconst byStage = {};\nconst repliesByCategory = {};\nconst hot = [];\nlet emailsSent = 0;\nlet followUpsSent = 0;\nlet optOuts = 0;\nfor (const r of rows) {\n  const stage = String(r['Stage'] || 'Unknown');\n  byStage[stage] = (byStage[stage] || 0) + 1;\n  if (within(r['Sent At'])) emailsSent++;\n  const count = Number(r['Follow-up Count'] || 0);\n  if (count > 0 && /^Follow-up/.test(stage) && within(r['Last Updated'])) followUpsSent++;\n  const replied = /^Replied/.test(stage) || String(r['Reply Category'] || '') !== '';\n  if (replied && within(r['Last Updated'])) {\n    const cat = String(r['Reply Category'] || stage.replace('Replied - ', ''));\n    repliesByCategory[cat] = (repliesByCategory[cat] || 0) + 1;\n    if (cat === 'Hot') hot.push({ name: r['Contact Name'], company: r['Company'], summary: r['Reply Summary'] });\n  }\n  if ((String(r['Opt-out'] || '') === 'Yes' || stage === 'Opted out') && within(r['Last Updated'])) optOuts++;\n}\nreturn [{ json: { totalLeads: rows.length, byStage, emailsSent, followUpsSent, repliesByCategory, optOutsLast7Days: optOuts, hotLeads: hot } }];"
      }
    },
